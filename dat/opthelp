msg_window    rappel des messages par ^P dans l'interface curses :      [r]
              reverse     -- fenêtre entière, plus récents d'abord
              full        -- fenêtre entière, plus anciens d'abord,
                             positionnée au départ sur la dernière page
                             pour voir les messages les plus récents
number_pad    déplacements par lettres ou par chiffres :                [0]
               0 -- déplacements traditionnels hjkl + yubn (défaut) ;
               1 -- déplacements par chiffres, pour le pavé numérique ;
               2 -- comme 1, mais '5' sert de préfixe 'g' au lieu de 'G' ;
               3 -- pavé de téléphone (1,2,3 en haut, 7,8,9 en bas) ;
               4 -- pavé de téléphone (3) combiné au choix de '5' (2) ;
              -1 -- "qwertz" ; déplacements par lettres, 'z' et 'y' échangés.
