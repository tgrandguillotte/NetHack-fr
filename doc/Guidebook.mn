.\" with an optional filtering step between 'cat' and 'tbl':
.\"  cat... |../util/makedefs --grep --input - --output - |tbl...
.
.if n \{\
.po 5n
.ll 70n
.lt 70n
.\}
.
.\" Load extra macros that "tmac.n" doesn't define.
.de So
.ie \n(.g&(\n(.x=1)&(\n(.y>22) .soquiet \\$1
.el                            .so      \\$1
..
.
.So tmac.nh
.if !\n(nH So doc/tmac.nh
.
.if !\n(nH \{\
.tm fatal error: cannot locate "tmac.nh" macro package
.ab
.\}
.
.rm So
.
